{
	"name": "staxpayments-agent-connector",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Multi-account Stax Payments MCP connector with read-only defaults and explicit write controls",
	"packageManager": "pnpm@11.5.1",
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/IndianMarshmello/staxpayments-agent-connector.git"
	},
	"bugs": {
		"url": "https://github.com/IndianMarshmello/staxpayments-agent-connector/issues"
	},
	"homepage": "https://github.com/IndianMarshmello/staxpayments-agent-connector#readme",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src test",
		"test": "bun --no-env-file test",
		"build": "bun build src/index.ts --target=bun --outdir=dist",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"ky": "^1.14.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/bun": "^1.3.0",
		"typescript": "^7.0.2"
	}
}
